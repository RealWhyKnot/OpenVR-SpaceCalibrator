#!/usr/bin/env bash
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: cannot find the repository; run from a Git checkout." >&2
  exit 1
}
if [ ! -f "$repo_root/.github/lint/lint.ps1" ]; then
  echo "pre-push: lint.ps1 is missing; restore .github/lint/lint.ps1." >&2
  exit 1
fi

pwsh_bin=""
for c in pwsh pwsh.exe; do
  if command -v "$c" >/dev/null 2>&1; then pwsh_bin="$c"; break; fi
done
if [ -z "$pwsh_bin" ]; then
  echo "pre-push: pwsh is missing; install PowerShell 7 and add pwsh to PATH." >&2
  exit 1
fi

for c in clang-format clang-tidy cmake ninja python; do
  if ! command -v "$c" >/dev/null 2>&1; then
    case "$c" in
      clang-format|clang-tidy) package="LLVM" ;;
      cmake) package="CMake" ;;
      ninja) package="Ninja" ;;
      python) package="Python" ;;
    esac
    echo "pre-push: $c is missing; install $package and add $c to PATH." >&2
    exit 1
  fi
done

echo "pre-push: checking repository formatting and clang-tidy." >&2
if ! "$pwsh_bin" -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.github/lint/lint.ps1" -Check; then
  echo "pre-push: lint failed; fix the errors and run pwsh .github/lint/lint.ps1 -Check." >&2
  exit 1
fi

echo "pre-push: lint check passed." >&2
exit 0
