#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @SPACECAL_VERSION_MAJOR@,@SPACECAL_VERSION_MINOR@,@SPACECAL_VERSION_PATCH@,@SPACECAL_VERSION_BUILD@
PRODUCTVERSION @SPACECAL_VERSION_MAJOR@,@SPACECAL_VERSION_MINOR@,@SPACECAL_VERSION_PATCH@,@SPACECAL_VERSION_BUILD@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "OpenVR Space Calibrator"
			VALUE "FileVersion", "@SPACECAL_VERSION@"
			VALUE "ProductName", "OpenVR-SpaceCalibrator"
			VALUE "ProductVersion", "@SPACECAL_VERSION@ (@SPACECAL_CHANNEL@)"
			VALUE "OriginalFilename", "SpaceCalibrator.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
